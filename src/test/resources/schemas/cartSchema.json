{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cart": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": ["integer", "string"]},
              "name": {"type": "string"},
              "quantity": {"type": ["integer", "string"]}
            },
            "required": ["id", "name"]
          }
        }
      },
      "required": ["items"]
    }
  },
  "required": ["cart"]
}