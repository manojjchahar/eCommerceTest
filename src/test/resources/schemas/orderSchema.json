{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "orders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": ["string", "integer"]},
          "userEmail": {"type": "string"},
          "products": {"type": "array"},
          "total": {"type": ["number", "string"]}
        },
        "required": ["id", "userEmail"]
      }
    }
  },
  "required": ["orders"]
}